<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="6dp" android:src="@drawable/w_dot_dim"/>
            <TextView android:id="@+id/w_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#8C8C8C" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_toggle" android:layout_width="64dp" android:layout_height="48dp" android:gravity="center"
        android:background="@drawable/w_btn_on" android:text="ON" android:textColor="#000000" android:textSize="15sp" android:textStyle="bold"/>
    <ImageView android:id="@+id/w_screen" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:padding="13dp"
        android:background="@drawable/w_btn_screen" android:src="@drawable/ic_tile_screen" android:contentDescription="Mac screen"/>
</LinearLayout>
