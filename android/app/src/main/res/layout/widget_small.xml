<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="18dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="7dp" android:importantForAccessibility="no" android:src="@drawable/w_dot_dim"/>
            <TextView android:id="@+id/w_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:textColor="#A0A0A0" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/w_screen" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginEnd="8dp" android:padding="12dp"
        android:background="@drawable/w_btn_screen" android:src="@drawable/ic_tile_screen" android:contentDescription="Mac screen"/>
    <ImageView android:id="@+id/w_toggle" android:layout_width="46dp" android:layout_height="46dp" android:padding="11dp"
        android:background="@drawable/w_btn_on" android:src="@drawable/ic_w_power_dark" android:contentDescription="Andromac connection"/>
</LinearLayout>
