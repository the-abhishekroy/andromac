<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_dot" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="8dp" android:src="@drawable/w_dot_dim"/>
                <TextView android:id="@+id/w_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:maxLines="1" android:textColor="#8C8C8C" android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/w_toggle" android:layout_width="88dp" android:layout_height="56dp" android:gravity="center"
            android:background="@drawable/w_btn_on" android:text="ON" android:textColor="#000000" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_screen" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp"
        android:background="@drawable/w_btn_screen" android:gravity="center" android:orientation="horizontal" android:contentDescription="Mac screen">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_tile_screen"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="Mac screen" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
